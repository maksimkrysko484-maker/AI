<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Код и Ток — Твой ИИ-ассистент</title>
  <style>
    /* --- СТИЛИ (CSS) --- */
    body {
      font-family: Arial, sans-serif;
      background-color: #f0f2f5;
      display: flex;
      justify-content: center;
      margin: 0;
      padding: 10px;
    }
    .container {
      background: white;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 420px;
      text-align: center;
    }
    h1 { color: #2c3e50; margin-bottom: 5px; }
    .subtitle { color: #7f8c8d; margin-bottom: 25px; font-size: 0.9em; }

    /* Тарифы */
    .pricing {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 25px;
    }
    .card {
      background: #fff;
      border: 1px solid #ddd;
      padding: 15px;
      border-radius: 10px;
      width: 140px;
      text-align: left;
      position: relative;
    }
    .popular { border: 2px solid #3498db; transform: scale(1.05); }
    .price {
      font-size: 1.2em;
      font-weight: bold;
      color: #2c3e50;
      margin: 10px 0;
    }
    button {
      width: 100%;
      padding: 10px;
      background-color: #3498db;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
    }
    button:hover { background-color: #2980b9; }
    .btn-buy { background-color: #2ecc71; }
    .btn-buy:hover { background-color: #27ae60; }

    /* Чат */
    .chat-box {
      margin-top: 20px;
      border: 1px solid #eee;
      padding: 15px;
      border-radius: 10px;
      background: #fafafa;
    }
    #chat-output {
      height: 180px;
      overflow-y: auto;
      text-align: left;
      margin-bottom: 10px;
      background: white;
      padding: 10px;
      border-radius: 8px;
      border: 1px dashed #ccc;
    }
    .msg { padding: 8px 12px; border-radius: 18px; margin-bottom: 6px; max-width: 80%; }
    .bot-msg { background-color: #e1f5fe; color: #000; align-self: flex-start; }
    .user-msg { background-color: #3498db; color: white; align-self: flex-end; }
    
    input {
      width: 70%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 20px;
      outline: none;
    }
  </style>
</head>
<body>

  <!-- --- КОНТЕНТ (HTML) --- -->
  <div class="container">
    <h1>Код и Ток</h1>
    <p class="subtitle">Автоматизирую рутину, пишу код, помогаю с Arduino.</p>

    <!-- Блок тарифов -->
    <div class="pricing">
      <div class="card">
        <h3>Старт</h3>
        <p>100 запросов к ИИ</p>
        <div class="price">990 ₽</div>
        <!-- Сюда вставишь ссылку на оплату позже -->
        <button class="btn-buy" onclick="alert('Ссылка на оплату: вставь сюда свою!')">Купить Старт</button>
      </div>
      <div class="card popular">
        <h3>Профи</h3>
        <p>500 запросов + Приоритет</p>
        <div class="price">2990 ₽</div>
        <button class="btn-buy" onclick="alert('Ссылка на оплату: вставь сюда свою!')">Купить Профи</button>
      </div>
    </div>

    <!-- Чат -->
    <div class="chat-box">
      <div id="chat-output">
        <div class="msg bot-msg">Привет! Я твой ассистент. Напиши про Arduino, сайт или автоматизацию — помогу!</div>
      </div>
      <input type="text" id="user-input" placeholder="Что нужно сделать?" />
      <button onclick="sendMessage()">Отправить</button>
    </div>
  </div>

  <script>
    // --- ЛОГИКА (JS) ---
    async function sendMessage() {
      const input = document.getElementById('user-input');
      const output = document.getElementById('chat-output');
      const text = input.value.trim();

      if (!text) return;

      // 1. Показываем сообщение пользователя
      const userDiv = document.createElement('div');
      userDiv.className = 'msg user-msg';
      userDiv.innerText = text;
      output.appendChild(userDiv);
      input.value = '';
      scrollToBottom();

      // 2. Имитация "печатания"
      const thinkingDiv = document.createElement('div');
      thinkingDiv.className = 'msg bot-msg';
      thinkingDiv.innerText = 'Думаю...';
      output.appendChild(thinkingDiv);
      scrollToBottom();

      try {
        // --- НАСТРОЙКА ИИ ---
        // ВСТАВЬ СЮДА СВОЙ КЛЮЧ ВМЕСТО 'ТВОЙ_DEEPSEEK_KEY'
        const apiKey = 'sk-3cca3806102c4e3d874e5c32fdc1596a'; 
        
        // Если ключа нет, включаем демо-режим (бот отвечает сам)
        if (apiKey === 'null') {
          console.log('Нет ключа, включаю демо');
          await simulateDemoResponse(thinkingDiv, text);
          return;
        }

        // Запрос к DeepSeek (настоящий ИИ)
        const response = await fetch('https://api.deepseek.com/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`
          },
          body: JSON.stringify({
            model: 'deepseek-chat',
            messages: [
              { 
                role: "system", 
                content: "Ты полезный ассистент 'Код и Ток'. Ты помогаешь с сайтами, Arduino и автоматизацией. Отвечай кратко, по делу, без воды. Если спрашивают про тарифы - скажи цены из интерфейса." 
              },
              { role: "user", content: text }
            ]
          })
        });

        const data = await response.json();
        const aiText = data.choices[0].message.content;

        thinkingDiv.innerText = aiText;
        scrollToBottom();

      } catch (error) {
        console.error(error);
        thinkingDiv.innerText = "Ой, сервер спит. Попробуй позже или напиши без ИИ.";
      }
    }

    function scrollToBottom() {
      const chat = document.getElementById('chat-output');
      chat.scrollTop = chat.scrollHeight;
    }

    // Функция для демо-режима (если нет ключа)
    async function simulateDemoResponse(element, text) {
      await new Promise(r => setTimeout(r, 1500));
      let reply = "Я пока без интернета, но идея крутая! Расскажи подробнее.";
      
      if (text.toLowerCase().includes('arduino')) {
        reply = "Для Arduino я бы начал со схемы. Что собираем: мигалку, датчик или умный дом?";
      } else if (text.toLowerCase().includes('сайт')) {
        reply = "Сайт — это просто. Хочешь, накидаю код главной страницы прямо тут?";
      } else if (text.toLowerCase().includes('тариф')) {
        reply = "У меня два тарифа: Старт (990₽, 100 запросов) и Профи (2990₽, 500 запросов). Кнопка покупки выше!";
      }
      
      element.innerText = reply;
    }
  </script>
</body>
</html>
